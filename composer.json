{
    "name": "nodeloc/lottery",
    "description": "A Flarum 2 extension that adds point-based lotteries to discussions",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/lowseekai/flarum-lottery/issues",
        "source": "https://github.com/lowseekai/flarum-lottery"
    },
    "homepage": "https://www.nodeloc.com",
    "funding": [
        {
            "type": "website",
            "url": "https://www.nodeloc.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-rc.8",
        "ramon/point-system": "dev-main"
    },
    "authors": [
        {
            "name": "James",
            "email": "james@nodeloc.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lowseekai/point-system"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nodeloc\\Lottery\\": "src/",
            "Nodeloc\\Lottery\\Migrations\\": "migrations/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Lottery",
            "category": "discussion",
            "icon": {
                "name": "fas fa-gift",
                "backgroundColor": "#006633",
                "color": "#fff"
            }
        },
        "flagrow": {
            "discuss": "https://www.nodeloc.com"
        }
    }
}
